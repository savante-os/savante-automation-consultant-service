# Copy to .env and fill in. The recommend flow runs offline (mock + dry-run) without these.

# DeepSeek synthesis via OpenRouter (without this, synthesis falls back to a deterministic mock)
OPENROUTER_API_KEY=

# Email delivery via Resend (without this, the email is written to out/ as a dry-run)
RESEND_API_KEY=
MAIL_FROM="Savante <hello@example.com>"

# Supabase (etapa 2 — loading the catalog + leads/recommendations)
# Also used server-side by the catalog-search edge function (never put the service role key in mcp.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Booking link used as the CTA in the plan email
BOOKING_URL=https://cal.com/your-handle/intro

# Catalog search MCP evaluation (scripts/eval-mcp.ts --mode live; see docs/MCP_TEST_PLAN.md)
MCP_CATALOG_URL=https://<your-project-ref>.supabase.co/functions/v1/catalog-search
MCP_API_KEY=
